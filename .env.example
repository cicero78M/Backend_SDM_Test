PORT=3000
# Gunakan database staging PostgreSQL yang sudah disiapkan untuk data SDM.
# Ganti nama database, user, dan password sesuai environment staging aktual.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/staging_sdm
JWT_SECRET=ganti-dengan-secret-minimal-32-karakter
JWT_EXPIRES_IN=1h
NODE_ENV=development
